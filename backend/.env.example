# Film Rewatch backend — environment configuration (DESIGN §3.5 config-over-code, §8).
#
# Copy this file to `.env` and fill in the values for your machine:
#     cp .env.example .env
# `.env` is git-ignored; this example is committed and documents every variable
# the backend reads (NFR-MAINT-04). Variable names map 1:1 to `app/core/config.py`.

# --- Database (required) -------------------------------------------------------
# SQLAlchemy URL for the authoritative Postgres store (DESIGN §2, §8.2). Required:
# the app fails fast at startup if it is missing. PR4 opens the connection; the
# exact driver is finalised there. For the Docker stack (PR6) the host is the
# `postgres` service name instead of `localhost`.
DATABASE_URL=postgresql+psycopg://filmrewatch:filmrewatch@localhost:5432/filmrewatch

# --- CORS (DESIGN §3.6/§8) -----------------------------------------------------
# Comma-separated list of allowed frontend origins. The backend hardcodes NO
# client origin — put the Angular app's origin here (its LAN address so the
# mobile PWA can reach it, e.g. http://192.168.1.10:4200). Empty disables all
# cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Server bind (optional; defaults shown) ------------------------------------
# Address/port uvicorn binds to inside the container (DESIGN §8.1).
HOST=0.0.0.0
PORT=8000

# --- Feature flags (DESIGN §5.6; optional, defaults shown) ---------------------
# Toggle the optional TMDB metadata adapter. Manual entry works fully when off.
FEATURE_TMDB_ADAPTER=false
