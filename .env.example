# Root .env — read automatically by Docker Compose for variable substitution in
# docker-compose.yml (§3.5 config-over-code, NFR-MAINT-04). Optional: every
# variable below has a working default, so the stack runs without this file.
# To override, copy to `.env` (git-ignored) and edit — never commit real values.
#
# NOTE: this is a DIFFERENT file from backend/.env (read by the app itself when
# run outside Docker — see backend/.env.example for those variables).

# PostgreSQL credentials — set on the DB container AND interpolated into the
# backend's DATABASE_URL by docker-compose.yml (the DB name is fixed).
POSTGRES_USER=filmrewatch
POSTGRES_PASSWORD=filmrewatch

# Frontend origin(s) the backend's CORS allows, comma-separated (§3.6). The
# default covers the Angular dev server; add the LAN origin the phone uses
# (§8.2), e.g.: http://localhost:4200,http://192.168.1.10:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
