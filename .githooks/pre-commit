#!/bin/sh
# Pre-commit gate (no CI — checks run locally, see CLAUDE.md "Workflow").
# Wired up via:  git config core.hooksPath .githooks   (once per clone)
#
# When staged changes touch frontend/: Prettier-checks the staged files, then
# runs ESLint over the workspace. Note: checks read the working tree, so
# partially-staged files are checked at their on-disk state.
# Skip once with:  git commit --no-verify

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FRONTEND="$(git diff --cached --name-only --diff-filter=ACMR | grep '^frontend/' || true)"

if [ -n "$STAGED_FRONTEND" ]; then
    # Check for empty .scss files (generated by schematic but not meant to be committed)
    echo "pre-commit: checking for empty .scss files..."
    EMPTY_SCSS=$(echo "$STAGED_FRONTEND" | grep '\.scss$' | while read f; do
        [ ! -s "$REPO_ROOT/$f" ] && echo "$f"
    done)
    if [ -n "$EMPTY_SCSS" ]; then
        echo "pre-commit: empty .scss files staged (delete or add styles):" >&2
        echo "$EMPTY_SCSS" | sed 's/^/  /' >&2
        exit 1
    fi

    echo "pre-commit: frontend files staged — running Prettier check..."
    echo "$STAGED_FRONTEND" | sed 's|^frontend/||' |
        (cd "$REPO_ROOT/frontend" && xargs npx prettier --check --ignore-unknown) || {
        echo "pre-commit: Prettier failed — run 'npm run format' in frontend/ (or commit with --no-verify)." >&2
        exit 1
    }

    echo "pre-commit: running ng lint..."
    (cd "$REPO_ROOT/frontend" && npm run --silent lint) || {
        echo "pre-commit: ESLint failed — commit aborted (fix or use --no-verify)." >&2
        exit 1
    }
fi
